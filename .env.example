# Copy to .env and edit. Every value is optional; defaults are shown.

# ---- Dataset (Amazon Reviews 2023, streamed from Hugging Face) -------------------
AMAZON_CATEGORY=All_Beauty        # file name in raw/review_categories, e.g. Appliances, Digital_Music
SAMPLE_REVIEWS=50000              # reviews to sample. 20000-50000 suits a student laptop
SCAN_MULTIPLIER=1                 # >1 reads N x SAMPLE_REVIEWS lines, then randomly subsamples
MIN_REVIEWS_PER_PRODUCT=5         # products with fewer reviews are dropped
META_SCAN_LIMIT=400000            # max metadata lines scanned to match products
RANDOM_SEED=42
# HF_TOKEN=                       # optional; only needed for rate limits / gated access

# ---- Sentiment ------------------------------------------------------------------
SENTIMENT_BACKEND=transformers    # transformers (DistilBERT) | lexicon (no torch, weaker) | none
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
SENTIMENT_BATCH_SIZE=32
SENTIMENT_MAX_LENGTH=128
SENTIMENT_MAX_REVIEWS=0           # 0 = score every review; e.g. 15000 to score a random subset on slow CPUs
SENTIMENT_NEUTRAL_BAND=0.15       # |P(positive)-0.5| below this counts as neutral (binary models only)

# ---- Suspicious-signal model ------------------------------------------------------
ANOMALY_CONTAMINATION=0.05
SUSPICION_FLAG_THRESHOLD=0.50
N_JOBS=0                          # 0 = all CPU cores

# ---- Paths ----------------------------------------------------------------------
# DATA_DIR=data
# MODELS_DIR=models
# DB_PATH=data/trust_assessor.sqlite

# ---- UI -------------------------------------------------------------------------
UI_HOST=127.0.0.1
UI_PORT=8080
SHOW_PRODUCT_IMAGES=true          # loads thumbnails from the dataset's image URLs (needs internet); false = offline
STORAGE_SECRET=change-me-locally
LOG_LEVEL=INFO
